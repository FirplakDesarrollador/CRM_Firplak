# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Supabase → Project Settings → API). Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la app (para enlaces de confirmación y recuperación de contraseña).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: dominios de correo permitidos para registrarse (separados por coma).
# Vacío = cualquier dominio.
ALLOWED_EMAIL_DOMAINS=firplak.com

# Opcional y SOLO servidor: habilita invitar usuarios desde Configuración → Usuarios.
# No uses el prefijo NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional y SOLO servidor: alternativa a la service_role para el servidor MCP (asistentes de IA).
# Es el «JWT Secret» heredado del proyecto (Supabase → Settings → API). Basta con una de las dos.
SUPABASE_JWT_SECRET=

# Opcional y SOLO servidor: envío de correos desde el CRM con Resend (https://resend.com).
# Sin estas variables, el CRM registra el correo y abre el cliente de correo del usuario.
RESEND_API_KEY=
EMAIL_FROM="Firplak CRM <crm@tu-dominio-verificado.com>"

# Opcional y SOLO servidor: Microsoft 365 (Outlook y Teams). Ver docs/puesta-en-produccion.md, sección 9.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# 32 bytes en base64 (openssl rand -base64 32): cifra los tokens de Microsoft guardados en la base.
MS365_ENCRYPTION_KEY=
